# Copy this file to `.env.local` and fill in the values.
# Find these in Supabase: Project Settings -> API (Project URL + anon / publishable key).
VITE_SUPABASE_URL=https://YOUR-PROJECT.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-or-publishable-key

# Optional defaults. Once Supabase is connected you can change these from /admin -> Settings
# without redeploying the site.
VITE_SIRKLE_JOIN_URL=
VITE_SIRKLE_CALENDAR_EMBED_URL=
